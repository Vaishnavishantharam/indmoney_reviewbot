# Phase 1 — Review ingest (scheduler uses 8 weeks, 1000 reviews)
APP_ID=in.indwealth
WEEKS_BACK=8
MAX_REVIEWS=1000

# Phase 2a/2b — Theme discovery & classification (Groq)
GROQ_API_KEY=

# Phase 3 — One-pager (Gemini)
GEMINI_API_KEY=

# Phase 4 — Email draft & send
EMAIL_SENDER=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional: default recipient when not provided by CLI/API (e.g. send to self)
EMAIL_RECIPIENT=
