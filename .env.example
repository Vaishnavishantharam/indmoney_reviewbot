# Phase 1 — Review ingest (scheduler uses 8 weeks, 1000 reviews)
APP_ID=in.indwealth
WEEKS_BACK=8
MAX_REVIEWS=1000

# Phase 2a/2b — Theme discovery & classification (Groq)
GROQ_API_KEY=

# Phase 3 — One-pager (Gemini)
GEMINI_API_KEY=

# Phase 4 — Email draft & send
EMAIL_SENDER=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional: default recipient when not provided by CLI/API (e.g. send to self)
EMAIL_RECIPIENT=

# Phase 3.1 / Part B — Fee explainer (≤6 bullets, 2 official links) + pulse_bundle / MCP append
# Primary fund page URL(s), comma-separated. If only one URL is set, a second official link (AMFI) is added automatically.
EXIT_LOAD_SOURCE_URL=https://www.indmoney.com/mutual-funds/hdfc-mid-cap-fund-direct-plan-growth-option-3097
# Optional: override the auto-paired second official link (default: AMFI investor information)
# EXIT_LOAD_SECOND_OFFICIAL_URL=https://www.amfiindia.com/investor-zone/investor-information
# Optional: 3–6 factual bullets as JSON when fetch/Playwright cannot read the page (Railway/Vercel)
# EXIT_LOAD_BULLETS_JSON=["Bullet 1…","Bullet 2…","Bullet 3…","Bullet 4…","Bullet 5…","Bullet 6…"]
# Email subject: default Part B = "Weekly Pulse + Fee Explainer — Week of …". Set to restore old subject:
# EMAIL_LEGACY_SUBJECT=1
# Optional: target Google Doc ID if you automate append (MCP usually uses Cursor config instead)
# GOOGLE_PULSE_DOC_ID=
